{
  "name": "utn-pps",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build:core": "pnpm --filter @pps/core build && pnpm --filter @pps/content build",
    "build": "pnpm build:core && pnpm --filter @pps/analytics-cli build",
    "typecheck": "pnpm build:core && pnpm -r --filter './workspaces/*' run typecheck",
    "test": "pnpm build:core && pnpm --filter @pps/analytics-cli test",
    "test:watch": "pnpm --filter @pps/analytics-cli test:watch",
    "inspect": "pnpm --filter @pps/analytics-cli inspect",
    "apply:analytics-sql": "node --env-file=.env scripts/apply-analytics-sql.mjs",
    "apply:auth-sql": "node --env-file=.env scripts/apply-auth-sql.mjs",
    "bundle:rebuild-analytics-edge": "node scripts/bundle-rebuild-analytics-edge.mjs",
    "deploy:rebuild-analytics": "node scripts/bundle-rebuild-analytics-edge.mjs && node scripts/deploy-rebuild-analytics.mjs",
    "build:content": "pnpm build:core && pnpm --filter @pps/analytics-cli build:analytics",
    "sync:pages": "pnpm build:core && node --env-file=.env scripts/sync-pages-to-storage.mjs",
    "build:cms": "pnpm build:core && pnpm --filter @pps/cms build",
    "build:cites": "pnpm build:core && pnpm --filter @pps/cites build",
    "build:users": "pnpm build:core && pnpm --filter @pps/users build",
    "build:site": "pnpm --filter @pps/site build",
    "build:analytics": "pnpm --filter @pps/analytics build",
    "build:network": "pnpm --filter @pps/network build",
    "build:roadmap": "pnpm --filter @pps/roadmap build",
    "build:tooling": "pnpm build:core && pnpm --filter @pps/config --filter @pps/shell --filter @pps/analytics-cli run build",
    "build:apps": "pnpm -r --filter @pps/site --filter @pps/cms --filter @pps/cites --filter @pps/users --filter @pps/analytics --filter @pps/network --filter @pps/roadmap run build",
    "build:pages": "pnpm build:tooling && pnpm build:apps && pnpm --filter @pps/config merge-pages",
    "dev": "pnpm build:tooling && pnpm --filter @pps/site dev",
    "watch:analytics": "pnpm --filter @pps/analytics-cli watch:analytics",
    "serve:dac": "pnpm --filter @pps/analytics-cli serve:dac"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "pg": "^8.23.0"
  }
}
