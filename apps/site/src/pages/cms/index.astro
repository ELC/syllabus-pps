---
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PPS CMS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700&family=Open+Sans:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href={`${base}styles/austral-tokens.css`} />
    <link rel="stylesheet" href={`${base}styles/dashboard.css`} />
  </head>
  <body class="dashboard-body">
    <div id="cms-root"></div>
    <script>
      import "../../components/cms-entry";
    </script>
  </body>
</html>
