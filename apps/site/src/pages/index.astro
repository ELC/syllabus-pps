---
import SiteLayout from "../layouts/SiteLayout.astro";

const base = import.meta.env.BASE_URL;

const links = [
  {
    href: `${base}analytics/`,
    title: "Analytics",
    description: "Quality, coverage, and curriculum dashboards generated from content/pages.",
  },
  {
    href: `${base}analytics/graph/`,
    title: "Graph explorer",
    description: "Interactive curriculum graph. Click to focus related nodes; double-click to open in the CMS.",
  },
  {
    href: `${base}cms/`,
    title: "CMS",
    description: "Edit repo-native Markdown with inline diagnostics.",
  },
];
---

<SiteLayout title="PPS Curriculum" activeNav="home">
  <header class="dashboard-header">
    <h1>PPS Curriculum</h1>
    <p>
      Repo-native curriculum notes, analytics, and authoring tools for the PPS zettelkasten.
    </p>
  </header>

  <section class="site-card-grid">
    {
      links.map((link) => (
        <a class="site-card" href={link.href}>
          <h2>{link.title}</h2>
          <p>{link.description}</p>
        </a>
      ))
    }
  </section>
</SiteLayout>
