---
interface Props {
  title: string;
  activeNav: "home" | "analytics" | "graph" | "cms";
}

const { title, activeNav } = Astro.props;
const base = import.meta.env.BASE_URL;
const cmsBase = `${base}cms/`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700&family=Open+Sans:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href={`${base}styles/austral-tokens.css`} />
    <link rel="stylesheet" href={`${base}styles/dashboard.css`} />
  </head>
  <body class="dashboard-body">
    <div class="dashboard-app">
      <aside class="dashboard-sidebar">
        <a class="dashboard-brand" href={base} aria-label="Universidad Austral — PPS Curriculum">
          <img src={`${base}brand/logo-horizontal-blanco.png`} alt="Universidad Austral" />
        </a>
        <nav class="dashboard-nav" aria-label="Site">
          <a class:list={["nav-link", { active: activeNav === "home" }]} href={base}>Home</a>
          <a class:list={["nav-link", { active: activeNav === "analytics" }]} href={`${base}analytics/`}>
            Analytics
          </a>
          <a class:list={["nav-link", { active: activeNav === "graph" }]} href={`${base}analytics/graph/`}>
            Graph explorer
          </a>
          <a class:list={["nav-link", { active: activeNav === "cms" }]} href={cmsBase}>CMS</a>
        </nav>
        <slot name="sidebar" />
        <div class="dashboard-sidebar-footer">PPS curriculum</div>
      </aside>
      <main class="dashboard-main">
        <slot />
      </main>
    </div>
  </body>
</html>
