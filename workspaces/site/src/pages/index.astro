---
import ShellLayout from "@pps/shell/ShellLayout.astro";
import { siteRootFromEnv } from "@pps/shell/site-root";
import siteCss from "../styles/site.scss?url";

const siteRoot = siteRootFromEnv(import.meta.env.BASE_URL);

const links = [
  {
    href: `${siteRoot}analytics/`,
    title: "Analytics",
    description: "Quality, coverage, and curriculum dashboards generated from Supabase content.",
  },
  {
    href: `${siteRoot}network/`,
    title: "Network",
    description: "Interactive curriculum graph. Click to focus related nodes; double-click to open in the CMS.",
  },
  {
    href: `${siteRoot}roadmap/`,
    title: "Roadmaps",
    description: "Self-paced degree roadmaps ordered by concept prerequisites.",
  },
  {
    href: `${siteRoot}cms/`,
    title: "CMS",
    description: "Edit curriculum markdown in Supabase Storage with inline diagnostics.",
  },
  {
    href: `${siteRoot}cites/`,
    title: "Cites",
    description: "Manage the shared CSL-JSON resource catalog in Supabase Postgres.",
  },
];
---

<ShellLayout title="PPS Curriculum" activeNav="home">
  <link slot="head" rel="stylesheet" href={siteCss} />
  <header class="dashboard__header">
    <h1 class="dashboard__header-title">PPS Curriculum</h1>
    <p class="dashboard__header-lead">
      Curriculum notes, analytics, and authoring tools for the PPS zettelkasten.
    </p>
  </header>

  <section class="site__cards">
    {
      links.map((link) => (
        <a class="site__card" href={link.href}>
          <h2 class="site__card-title">{link.title}</h2>
          <p class="site__card-desc">{link.description}</p>
        </a>
      ))
    }
  </section>
</ShellLayout>
