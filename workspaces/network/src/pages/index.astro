---
import ShellLayout from "@pps/shell/ShellLayout.astro";
import metaDropdownCss from "@pps/shell/styles/meta-dropdown.scss?url";
import networkCss from "../styles/network.scss?url";
---

<ShellLayout title="PPS Network" activeNav="network">
  <link slot="head" rel="stylesheet" href={metaDropdownCss} />
  <link slot="head" rel="stylesheet" href={networkCss} />
  <div slot="sidebar" class="graph__sidebar-filters dashboard__nav--sub">
    <button
      id="graph-refresh-layout"
      type="button"
      class="graph__sidebar-refresh"
      title="Recomputar el layout del grafo visible"
    >
      ↻ Reordenar
    </button>
    <button
      id="graph-toggle-concepts"
      type="button"
      class="graph__sidebar-toggle-concepts"
      aria-pressed="true"
      title="Volver a mostrar los nodos de concepto"
    >
      Mostrar conceptos
    </button>
    <button
      id="graph-toggle-course-links"
      type="button"
      class="graph__sidebar-toggle-course-links"
      aria-pressed="true"
      title="Mostrar enlaces de mención entre materias (wikilinks)"
    >
      Mostrar Menciones
    </button>
    <div class="graph__sidebar-label-row">
      <p class="graph__sidebar-label">Filtros</p>
      <button
        type="button"
        class="graph__filters-info"
        aria-label="Ayuda sobre los filtros"
        aria-describedby="graph-filters-help-tooltip"
      >
        <span class="graph__filters-info-icon" aria-hidden="true">
          <svg viewBox="0 0 8 12" width="8" height="12" focusable="false">
            <circle cx="4" cy="2.25" r="1.15" fill="currentColor"></circle>
            <rect x="3.1" y="4.75" width="1.8" height="6.5" rx="0.9" fill="currentColor"></rect>
          </svg>
        </span>
      </button>
      <span class="graph__filters-info-tooltip" role="tooltip" id="graph-filters-help-tooltip">
        Cada filtro muestra el nodo elegido y todos los que tienen un camino dirigido hacia él. No es
        lo mismo que hacer clic en el grafo, que expande el vecindario de un nodo.
      </span>
    </div>
    <div
      id="graph-filters"
      class="graph__filters-list"
      aria-busy="true"
      aria-label="Cargando filtros del grafo"
    >
      <div class="graph__filter graph__filter--loading" aria-hidden="true">
        <span class="network__skeleton graph__filter-skeleton-label"></span>
        <span class="network__skeleton graph__filter-skeleton-select"></span>
      </div>
      <div class="graph__filter graph__filter--loading" aria-hidden="true">
        <span class="network__skeleton graph__filter-skeleton-label"></span>
        <span class="network__skeleton graph__filter-skeleton-select"></span>
      </div>
    </div>
    <button
      id="graph-reset-filters"
      type="button"
      class="graph__sidebar-reset-filters"
      title="Quitar todos los filtros del sidebar"
    >
      Limpiar filtros
    </button>
  </div>

  <header class="dashboard__header">
    <div class="dashboard__header-top">
      <div class="dashboard__header-title-band">
        <div class="network__header-title-row dashboard__header-title-row">
          <h1 class="dashboard__header-title">Curriculum network</h1>
          <span id="network-rebuild-indicator"></span>
        </div>
      </div>
      <div class="dashboard__header-lead-row">
      <p class="dashboard__header-lead">
        Filter or search to narrow the graph. Click a node to focus; double-click opens CMS. Clear
        expansions with × on chips.
      </p>
      <div
        id="graph-course-workspace-links"
        class="network__header-workspace-links pps-workspace-nav-links"
      ></div>
      </div>
    </div>
    <div class="graph__header-meta graph__header-meta--compact">
      <div class="graph__header-meta-leading">
        <span class="network__degree-label">Carrera</span>
        <div class="network__degree-control">
          <span
            id="graph-degree-scope-skeleton"
            class="network__skeleton network__skeleton--course"
            aria-hidden="true"
            aria-busy="true"
          ></span>
          <div id="graph-degree-scope-root" class="network__degree-dropdown-host" hidden></div>
        </div>
      </div>
      <div class="graph__header-actions">
        <div class="graph__search">
          <label class="u-visually-hidden" for="graph-search">Buscar</label>
          <input
            id="graph-search"
            class="graph__search-input"
            type="search"
            placeholder="Filtrar nodos por nombre..."
            autocomplete="off"
            role="combobox"
            aria-expanded="false"
            aria-controls="graph-search-results"
            aria-autocomplete="list"
          />
          <div id="graph-search-results" class="graph__search-dropdown" role="listbox"></div>
        </div>
      </div>
    </div>
    <ul id="graph-legend" class="graph__legend graph__legend--below-meta" aria-label="Tipos de nodo"></ul>
  </header>

  <section class="graph__panel">
    <div id="graph-expansion-list" class="graph__expansion-list" hidden></div>
    <div class="graph__canvas"></div>
  </section>

  <aside id="graph-concept-panel" class="graph__concept-panel" aria-hidden="true">
    <div class="graph__concept-backdrop"></div>
    <div
      class="graph__concept-sheet"
      role="dialog"
      aria-modal="true"
      aria-labelledby="graph-concept-panel-title"
    >
      <header class="graph__concept-header">
        <div class="graph__concept-header-lead">
          <h2 id="graph-concept-panel-title" class="graph__concept-title"></h2>
          <div
            id="graph-concept-cms-link"
            class="graph__concept-cms-link pps-workspace-nav-links"
            hidden
          ></div>
        </div>
        <button type="button" class="graph__concept-close" aria-label="Cerrar">×</button>
      </header>
      <div id="graph-concept-panel-notes" class="graph__concept-body"></div>
    </div>
  </aside>

  <script>
    import { mountAnalyticsRebuildIndicator } from "@pps/shell/mount-analytics-rebuild-indicator";
    import { mountGraph, seedCourseWorkspaceLinksFromUrl } from "../scripts/graph";

    seedCourseWorkspaceLinksFromUrl(document.getElementById("graph-course-workspace-links"));

    const rebuildIndicatorHost = document.getElementById("network-rebuild-indicator");
    if (rebuildIndicatorHost) {
      mountAnalyticsRebuildIndicator(rebuildIndicatorHost, { className: "network__rebuild-indicator" });
    }

    mountGraph("graph__canvas", {
      filtersRootId: "graph-filters",
      searchInputId: "graph-search",
      searchResultsId: "graph-search-results",
      expansionListId: "graph-expansion-list",
      courseWorkspaceLinksId: "graph-course-workspace-links",
      refreshButtonId: "graph-refresh-layout",
      resetFiltersButtonId: "graph-reset-filters",
      toggleConceptsButtonId: "graph-toggle-concepts",
      degreeScopeRootId: "graph-degree-scope-root",
      degreeScopeSkeletonId: "graph-degree-scope-skeleton",
      legendRootId: "graph-legend",
      toggleCourseLinksButtonId: "graph-toggle-course-links",
      conceptPanelId: "graph-concept-panel",
    }).catch((error) => {
      console.error(error);
      const container = document.querySelector(".graph__canvas");
      if (container) {
        container.textContent =
          "Failed to load graph from Supabase. Apply analytics SQL and run pnpm build:content.";
      }
    });
  </script>
</ShellLayout>
