{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/load-analytics-artifact.ts",
    "src/trigger-analytics-rebuild.ts",
    "src/analytics-rebuild-status-browser.ts",
    "src/browser.ts",
    "src/editor-catalog-sync.ts"
  ]
}
