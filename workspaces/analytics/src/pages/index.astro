---
import ShellLayout from "@pps/shell/ShellLayout.astro";
import analyticsCss from "../styles/analytics.css?url";
---

<ShellLayout title="PPS Analytics" activeNav="analytics">
  <link slot="head" rel="stylesheet" href={analyticsCss} />
  <nav slot="sidebar" id="dashboard-tabs" class="dashboard-nav dashboard-nav-sub" aria-label="Dashboards"></nav>
  <div id="analytics-root"></div>
  <script>
    import { mountAnalyticsDashboard } from "../scripts/analytics-dashboard";

    mountAnalyticsDashboard("analytics-root", "dashboard-tabs", "./data/dashboards.json").catch((error) => {
      console.error(error);
      const root = document.getElementById("analytics-root");
      if (root) {
        root.innerHTML =
          '<p class="dashboard-error">Failed to load analytics dashboards. Run <code>pnpm build:content</code> first.</p>';
      }
    });
  </script>
</ShellLayout>
