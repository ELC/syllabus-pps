---
import ShellLayout from "@pps/shell/ShellLayout.astro";
import analyticsCss from "../styles/analytics.scss?url";
---

<ShellLayout title="PPS Analytics" activeNav="analytics">
  <link slot="head" rel="stylesheet" href={analyticsCss} />
  <nav slot="sidebar" id="dashboard-tabs" class="dashboard__nav dashboard__nav--sub" aria-label="Dashboards"></nav>
  <div class="analytics" data-analytics-root></div>
  <script>
    import { mountAnalyticsDashboard } from "../scripts/analytics-dashboard";

    mountAnalyticsDashboard("analytics", "dashboard-tabs", "./data/dashboards.json").catch((error) => {
      console.error(error);
      const root = document.querySelector(".analytics");
      if (root) {
        root.innerHTML =
          '<p class="dashboard__error">Failed to load analytics dashboards. Run <code>pnpm build:content</code> first.</p>';
      }
    });
  </script>
</ShellLayout>
