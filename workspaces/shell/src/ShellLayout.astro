---
import authCriticalCss from "@pps/login/styles/auth-critical.css?raw";
import authCss from "@pps/login/styles/login.css?url";
import { OPTIMISTIC_AUTH_BOOTSTRAP_SCRIPT } from "@pps/login/sessionStorage";
import {
  SHELL_LOGO_ALT,
  SHELL_LOGO_HEIGHT,
  SHELL_LOGO_WIDTH,
  shellLogoHref,
} from "./logo-meta";
import shellCss from "@pps/shell/styles/shell.css?url";
import { NAV_ITEMS, navHref } from "./nav";
import type { NavId } from "./site-root";
import { siteRootFromEnv } from "./site-root";

interface Props {
  title: string;
  activeNav: NavId;
}

const { title, activeNav } = Astro.props;
const siteRoot = siteRootFromEnv(import.meta.env.BASE_URL);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style is:inline data-pps-auth-critical set:html={authCriticalCss} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700&family=Open+Sans:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href={shellCss} />
    <link rel="stylesheet" href={authCss} />
    <script is:inline set:html={OPTIMISTIC_AUTH_BOOTSTRAP_SCRIPT} />
    <slot name="head" />
  </head>
  <body class="dashboard-body auth-pending">
    <div class="dashboard-app">
      <aside class="dashboard-sidebar">
        <a class="dashboard-brand" href={siteRoot} aria-label="Universidad Austral — PPS Curriculum">
          <img
            src={shellLogoHref(siteRoot)}
            alt={SHELL_LOGO_ALT}
            width={SHELL_LOGO_WIDTH}
            height={SHELL_LOGO_HEIGHT}
            decoding="async"
          />
        </a>
        <nav class="dashboard-nav" aria-label="Site">
          {
            NAV_ITEMS.map((item) => (
              <a
                class:list={["nav-link", { active: item.id === activeNav }]}
                href={navHref(siteRoot, item.segment)}
                aria-current={item.id === activeNav ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <slot name="sidebar" />
        <div class="dashboard-sidebar-footer">
          <div class="dashboard-sidebar-user" aria-live="polite">
            <div class="dashboard-sidebar-user-name" data-pps-user-name hidden>&nbsp;</div>
            <div class="dashboard-sidebar-user-email" data-pps-user-email>&nbsp;</div>
          </div>
          <div class="dashboard-sidebar-signout-slot">
            <button type="button" class="login-sign-out" data-pps-sign-out hidden>Sign out</button>
          </div>
        </div>
      </aside>
      <main class="dashboard-main">
        <slot />
      </main>
    </div>
    <script>
      import { mountShellAuth } from "@pps/login/mountShellAuth";

      void mountShellAuth();
    </script>
  </body>
</html>
