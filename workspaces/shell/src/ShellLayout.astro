---
import logoUrl from "../brand/logo-horizontal-blanco.png";
import { NAV_ITEMS, navHref } from "./nav";
import type { NavId } from "./site-root";
import { shellStylesHref, siteRootFromEnv } from "./site-root";

interface Props {
  title: string;
  activeNav: NavId;
}

const { title, activeNav } = Astro.props;
const siteRoot = siteRootFromEnv(import.meta.env.BASE_URL);
const shellCss = shellStylesHref(import.meta.env.BASE_URL);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700&family=Open+Sans:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href={shellCss} />
    <slot name="head" />
  </head>
  <body class="dashboard-body">
    <div class="dashboard-app">
      <aside class="dashboard-sidebar">
        <a class="dashboard-brand" href={siteRoot} aria-label="Universidad Austral — PPS Curriculum">
          <img src={logoUrl.src} alt="Universidad Austral" />
        </a>
        <nav class="dashboard-nav" aria-label="Site">
          {
            NAV_ITEMS.map((item) => (
              <a
                class:list={["nav-link", { active: item.id === activeNav }]}
                href={navHref(siteRoot, item.segment)}
                aria-current={item.id === activeNav ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <slot name="sidebar" />
        <div class="dashboard-sidebar-footer">PPS curriculum</div>
      </aside>
      <main class="dashboard-main">
        <slot />
      </main>
    </div>
  </body>
</html>
