---
import authCriticalCss from "@pps/login/styles/auth-critical.scss?inline";
import authCss from "@pps/login/styles/login.scss?url";
import { OPTIMISTIC_AUTH_BOOTSTRAP_SCRIPT } from "@pps/login/sessionStorage";
import { SHELL_SIDEBAR_FOOTER_HTML } from "@pps/login/sidebar-footer-html";
import {
  SHELL_ISOLOGO_ALT,
  SHELL_ISOLOGO_HEIGHT,
  SHELL_ISOLOGO_WIDTH,
  SHELL_LOGO_HEIGHT,
  SHELL_LOGO_WIDTH,
  shellIsologoHref,
  shellLogoHref,
} from "./logo-meta";
import shellCss from "@pps/shell/styles/shell.scss?url";
import GoogleAnalytics from "./GoogleAnalytics.astro";
import { navIconSvg, navToggleIconSvg, sidebarCollapseIconSvg } from "./nav-icons";
import { NAV_ITEMS, navHref } from "./nav";
import type { NavId } from "./site-root";
import {
  ETHICAL_ADS_KEYWORDS,
  ETHICAL_ADS_PUBLISHER_ID,
  ethicalAdsFooterPlacementId,
} from "./ethical-ads";
import { siteRootFromEnv } from "./site-root";

interface Props {
  title: string;
  activeNav: NavId;
  /** EthicalAds text placement in the unified session banner bar (default on). */
  sessionBannerEthicalAds?: boolean;
}

const { title, activeNav, sessionBannerEthicalAds = true } = Astro.props;
const hasSessionBanner = Astro.slots.has("session-banner");
const showSessionBanner = sessionBannerEthicalAds || hasSessionBanner;
const ethicalAdsPlacementId = ethicalAdsFooterPlacementId(activeNav);
const siteRoot = siteRootFromEnv(import.meta.env.BASE_URL);
const logoHref = shellLogoHref(siteRoot);
const isologoHref = shellIsologoHref(siteRoot);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style is:inline data-pps-auth-critical set:html={authCriticalCss} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700&family=Open+Sans:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href={shellCss} />
    <link rel="stylesheet" href={authCss} />
    <script is:inline set:html={OPTIMISTIC_AUTH_BOOTSTRAP_SCRIPT} />
    <GoogleAnalytics />
    <slot name="head" />
  </head>
  <body class="dashboard--body auth-pending">
    <div class="dashboard">
      <aside class="dashboard__sidebar">
        <div class="dashboard__sidebar-head">
          <a class="dashboard__brand" href={siteRoot} aria-label="Universidad Austral — PPS Curriculum">
            <img
              class="dashboard__brand-logo"
              data-pps-shell-logo
              src={logoHref}
              alt={SHELL_ISOLOGO_ALT}
              width={SHELL_LOGO_WIDTH}
              height={SHELL_LOGO_HEIGHT}
              decoding="async"
            />
            <img
              class="dashboard__brand-isologo"
              data-pps-shell-isologo
              src={isologoHref}
              alt=""
              width={SHELL_ISOLOGO_WIDTH}
              height={SHELL_ISOLOGO_HEIGHT}
              decoding="async"
              aria-hidden="true"
            />
          </a>
        </div>
        <button
          type="button"
          class="dashboard__nav-toggle"
          aria-expanded="false"
          aria-controls="dashboard-mobile-nav"
          title="Abrir menú"
        >
          <span class="dashboard__nav-toggle-icon" set:html={navToggleIconSvg(false)} />
        </button>
        <div id="dashboard-mobile-nav" class="dashboard__sidebar-drawer">
          <div class="dashboard__sidebar-drawer-panel">
            <nav id="dashboard-site-nav" class="dashboard__nav" aria-label="Site">
              {
                NAV_ITEMS.map((item) => (
                  <a
                    class:list={["dashboard__link", { "dashboard__link--active": item.id === activeNav }]}
                    data-pps-nav-id={item.id}
                    href={navHref(siteRoot, item.segment)}
                    aria-current={item.id === activeNav ? "page" : undefined}
                    title={item.label}
                  >
                    <span class="dashboard__link-icon" set:html={navIconSvg(item.id)} />
                    <span class="dashboard__link-label">{item.label}</span>
                  </a>
                ))
              }
            </nav>
            <slot name="sidebar" />
            <Fragment set:html={SHELL_SIDEBAR_FOOTER_HTML} />
          </div>
        </div>
      </aside>
      <button
        type="button"
        class="dashboard__sidebar-collapse"
        aria-expanded="true"
        aria-controls="dashboard-site-nav"
        title="Contraer barra lateral"
      >
        <span class="dashboard__sidebar-collapse-icon" set:html={sidebarCollapseIconSvg(false)} />
      </button>
      <main class="dashboard__main">
        <div class="dashboard__content">
          <slot />
        </div>
        {
          showSessionBanner ? (
            <div class="dashboard__main-foot" data-pps-main-foot hidden>
              <div
                class:list={[
                  "dashboard__session-banner",
                  sessionBannerEthicalAds && "dashboard__ethical-ads flat adaptive-css",
                ]}
                id={sessionBannerEthicalAds ? ethicalAdsPlacementId : undefined}
                role="region"
                aria-label={sessionBannerEthicalAds ? "Publicidad" : "Aviso"}
                data-pps-session-banner
                data-ea-publisher={sessionBannerEthicalAds ? ETHICAL_ADS_PUBLISHER_ID : undefined}
                data-ea-type={sessionBannerEthicalAds ? "text" : undefined}
                data-ea-keywords={sessionBannerEthicalAds ? ETHICAL_ADS_KEYWORDS : undefined}
                hidden
              >
                {!sessionBannerEthicalAds ? <slot name="session-banner" /> : null}
              </div>
              <button
                type="button"
                class="dashboard__session-banner-close"
                data-pps-session-banner-close
                aria-label="Cerrar aviso"
              >
                ×
              </button>
            </div>
          ) : null
        }
      </main>
    </div>
    <script>
      import { mountShellAuth } from "@pps/login/mountShellAuth";
      import { mountShellSidebar } from "@pps/shell/mount-shell-sidebar";

      import { scheduleMountSessionBanner } from "@pps/shell/session-banner";

      mountShellSidebar();
      scheduleMountSessionBanner();
      void mountShellAuth();
    </script>
  </body>
</html>
