# Supabase project URL (browser AuthN, builds, and optional analytics-cli sync).
PUBLIC_SUPABASE_PROJECT_URL=
# Publishable key for browser AuthN (never use the service role here).
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional Google Analytics 4 measurement ID (G-XXXXXXXX). Loaded in production builds only.
PUBLIC_GA_MEASUREMENT_ID=
