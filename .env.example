# Supabase project URL (browser AuthN and builds).
PUBLIC_SUPABASE_PROJECT_URL=
# Publishable key for browser AuthN (never use the service role here).
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role key for analytics builds, CMS/Cites dev proxy, and CLI (never commit; CI secret only).
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for markdown pages (default: content).
SUPABASE_STORAGE_BUCKET=
# Optional Google Analytics 4 measurement ID (G-XXXXXXXX). Loaded in production builds only.
PUBLIC_GA_MEASUREMENT_ID=
# Local dev only: skip Supabase login when true. CMS/Cites still use Supabase via a dev server proxy.
PUBLIC_AUTH_DISABLED=true
# Postgres pooler for Bruin DAC (`pnpm serve:dac` / `dac check`). Same DB as Supabase project.
SUPABASE_DB_HOST=
# Session pooler (5432) for migrations (`pnpm apply:analytics-sql`); transaction pooler (6543) is fine for DAC.
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSL_MODE=require
